local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local savedPos

local gui = Instance.new("ScreenGui")
gui.Name = "DragonZpeed"
gui.ResetOnSpawn = false
gui.Parent = game.CoreGui

local frame = Instance.new("Frame")
frame.Parent = gui
frame.Size = UDim2.new(0,220,0,180)
frame.Position = UDim2.new(0.4,0,0.3,0)
frame.BackgroundColor3 = Color3.fromRGB(10,10,10)
frame.Active = true

Instance.new("UICorner", frame).CornerRadius = UDim.new(0,15)

local stroke = Instance.new("UIStroke")
stroke.Parent = frame
stroke.Thickness = 4

local title = Instance.new("TextLabel")
title.Parent = frame
title.Size = UDim2.new(1,0,0,40)
title.BackgroundTransparency = 1
title.Text = "DragonZpeed"
title.Font = Enum.Font.GothamBold
title.TextScaled = true

local saveBtn = Instance.new("TextButton")
saveBtn.Parent = frame
saveBtn.Size = UDim2.new(0.85,0,0,50)
saveBtn.Position = UDim2.new(0.075,0,0.30,0)
saveBtn.Text = "Saved"
saveBtn.Font = Enum.Font.GothamBold
saveBtn.TextScaled = true
saveBtn.BackgroundColor3 = Color3.fromRGB(25,25,25)
saveBtn.TextColor3 = Color3.new(1,1,1)

Instance.new("UICorner", saveBtn).CornerRadius = UDim.new(0,12)

local saveStroke = Instance.new("UIStroke")
saveStroke.Parent = saveBtn
saveStroke.Thickness = 2

local tpBtn = Instance.new("TextButton")
tpBtn.Parent = frame
tpBtn.Size = UDim2.new(0.85,0,0,50)
tpBtn.Position = UDim2.new(0.075,0,0.65,0)
tpBtn.Text = "Teleport"
tpBtn.Font = Enum.Font.GothamBold
tpBtn.TextScaled = true
tpBtn.BackgroundColor3 = Color3.fromRGB(25,25,25)
tpBtn.TextColor3 = Color3.new(1,1,1)

Instance.new("UICorner", tpBtn).CornerRadius = UDim.new(0,12)

local tpStroke = Instance.new("UIStroke")
tpStroke.Parent = tpBtn
tpStroke.Thickness = 2

-- Save Position
saveBtn.MouseButton1Click:Connect(function()
	local char = player.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		savedPos = char.HumanoidRootPart.CFrame
		saveBtn.Text = "Saved ✓"
		task.wait(1)
		saveBtn.Text = "Saved"
	end
end)

-- Teleport
tpBtn.MouseButton1Click:Connect(function()
	local char = player.Character
	if savedPos and char and char:FindFirstChild("HumanoidRootPart") then
		char.HumanoidRootPart.CFrame = savedPos
	end
end)

-- Rainbow
local hue = 0
RunService.RenderStepped:Connect(function()
	hue = (hue + 0.003) % 1
	local color = Color3.fromHSV(hue,1,1)

	stroke.Color = color
	saveStroke.Color = color
	tpStroke.Color = color
	title.TextColor3 = color
end)

-- Drag UI
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
	local delta = input.Position - dragStart
	frame.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = frame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

title.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input == dragInput then
		update(input)
	end
end)

-- Resize Handle
local resize = Instance.new("TextButton")
resize.Parent = frame
resize.Size = UDim2.new(0,20,0,20)
resize.Position = UDim2.new(1,-22,1,-22)
resize.Text = "◢"
resize.TextScaled = true
resize.BackgroundTransparency = 1
resize.TextColor3 = Color3.new(1,1,1)

local resizing = false
local resizeStart
local startSize

resize.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then

		resizing = true
		resizeStart = input.Position
		startSize = frame.Size

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				resizing = false
			end
		end)
	end
end)

UIS.InputChanged:Connect(function(input)
	if resizing then
		local delta = input.Position - resizeStart

		frame.Size = UDim2.new(
			0,
			math.max(180, startSize.X.Offset + delta.X),
			0,
			math.max(150, startSize.Y.Offset + delta.Y)
		)
	end
end)
